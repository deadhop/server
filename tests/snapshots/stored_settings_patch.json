{
  "name": "snapshot service",
  "proxies": {
    "default": {
      "proxy": "tor"
    },
    "groups": [
      {
        "chaos_max_secs": 600,
        "chaos_min_secs": 120,
        "id": "exits",
        "name": "Exits",
        "proxies": [
          "tor",
          "vpn"
        ],
        "rotate_secs": 1800,
        "strategy": "round_robin"
      }
    ],
    "i2p_registries": [
      "http://notbob.i2p/cgi-bin/jump.cgi?q={name}",
      "http://reg.i2p/?a={name}"
    ],
    "list": [
      {
        "id": "tor",
        "name": "Tor",
        "url": "socks5://127.0.0.1:9050"
      },
      {
        "id": "vpn",
        "name": "VPN",
        "url": "socks5://user:secret@10.8.0.1:1080"
      },
      {
        "i2p": true,
        "id": "i2p",
        "name": "I2P router",
        "url": "http://127.0.0.1:4444"
      }
    ],
    "offline": "kill_switch",
    "rules": [
      {
        "fallback": "offline",
        "keys": [],
        "match": [
          "*.onion"
        ],
        "name": "onions",
        "to": {
          "proxy": "tor"
        }
      },
      {
        "fallback": "offline",
        "keys": [],
        "match": [
          "*.i2p"
        ],
        "name": "i2p",
        "to": {
          "proxy": "i2p"
        }
      },
      {
        "fallback": "offline",
        "keys": [],
        "match": [
          "wss://relay-b.example"
        ],
        "name": "",
        "to": "direct"
      },
      {
        "fallback": "offline",
        "keys": [],
        "match": [
          "relay-c.example:7777"
        ],
        "name": "never",
        "to": "block"
      },
      {
        "fallback": "policy",
        "keys": [],
        "match": [
          "relay-a.example"
        ],
        "name": "",
        "to": {
          "group": "exits"
        }
      }
    ]
  },
  "relay_names": {
    "ws://nostr-not.i2p": "nostr-not.i2p",
    "wss://relay-a.example": "Relay A"
  },
  "relays": [
    "wss://relay-a.example",
    "wss://relay-b.example",
    "ws://abcdefghij.onion",
    "ws://nostr-not.i2p"
  ]
}
